# ===== FisGrade v1.1 — Environment Variables Template =====
# Salin file ini menjadi .env di direktori yang sesuai
# JANGAN commit .env ke Git!

# --- App ---
APP_ENV=production

# --- Database (Supabase PostgreSQL) ---
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require

# --- Security (Buat nilai random untuk production!) ---
SECRET_KEY=ganti-dengan-string-random-minimal-32-karakter
ENCRYPTION_KEY=ganti-dengan-base64-string-32-byte
NIM_HASH_PEPPER=ganti-dengan-string-random

# --- CORS (URL frontend Vercel) ---
CORS_ORIGINS=https://NAMA-PROYEK.vercel.app

# --- LLM (Groq) ---
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_...isi_api_key_groq...
GROQ_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_MS=15000
LLM_MIN_CONFIDENCE=0.6
LLM_CALLS_PER_PARTICIPANT_PER_MIN=6

# --- Frontend (Next.js, set di Vercel env vars) ---
NEXT_PUBLIC_API_URL=https://URL-BACKEND-RAILWAY-ATAU-RENDER.app

# --- Asesmen Logic ---
CHECK_IDLE_MS=7000
CHECK_MIN_INTERVAL_MS=3000
MAX_ATTEMPTS=3
STAGNATION_SEC=60
HINT_PENALTIES=5,10,10
HINT3_DELAY_SEC=15
DATA_RETENTION_DAYS=365
